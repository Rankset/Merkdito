@page "/"
@using System.Net
@using System.Net.Http.Json
@using Merkdito.Web.Services
@inject AuthService Auth
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<PageTitle>Merkdito - Painel administrativo</PageTitle>

<div class="container-fluid py-4 px-lg-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="text-primary fw-semibold small text-uppercase">Painel administrativo</span>
            <h1 class="fw-bold mt-1 mb-2">Bem-vindo, @(Auth.Nome ?? "Administrador")</h1>
            <p class="text-muted mb-0">Acompanhe os clientes cadastrados e gerencie os acessos ao Merkdito.</p>
        </div>
        <a href="/admin/clientes" class="btn btn-primary px-4 py-2">
            <i class="bi bi-person-plus me-2" aria-hidden="true"></i> Cadastrar cliente
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensagem))
    {
        <div class="alert @(erro ? "alert-danger" : "alert-info")" role="alert" aria-live="polite">@mensagem</div>
    }

    @if (carregando)
    {
        <div class="text-muted py-5" role="status">
            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            Carregando indicadores dos clientes...
        </div>
    }
    else if (!erro)
    {
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100"><div class="card-body p-4">
                    <div class="d-flex align-items-start justify-content-between gap-3">
                        <div><p class="text-muted mb-2">Total de clientes</p><div class="display-6 fw-bold">@clientes.Count</div></div>
                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3"><i class="bi bi-people fs-4" aria-hidden="true"></i></div>
                    </div>
                    <a href="/admin/clientes" class="small text-decoration-none">Consultar clientes <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                </div></div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100"><div class="card-body p-4">
                    <div class="d-flex align-items-start justify-content-between gap-3">
                        <div><p class="text-muted mb-2">Clientes ativos</p><div class="display-6 fw-bold">@clientes.Count(c => c.Ativo)</div></div>
                        <div class="rounded-3 bg-success bg-opacity-10 text-success p-3"><i class="bi bi-person-check fs-4" aria-hidden="true"></i></div>
                    </div>
                    <span class="small text-muted">Contas habilitadas</span>
                </div></div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100"><div class="card-body p-4">
                    <div class="d-flex align-items-start justify-content-between gap-3">
                        <div><p class="text-muted mb-2">Clientes inativos</p><div class="display-6 fw-bold">@clientes.Count(c => !c.Ativo)</div></div>
                        <div class="rounded-3 bg-secondary bg-opacity-10 text-secondary p-3"><i class="bi bi-person-x fs-4" aria-hidden="true"></i></div>
                    </div>
                    <span class="small text-muted">Contas desabilitadas</span>
                </div></div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100"><div class="card-body p-4">
                    <div class="d-flex align-items-start justify-content-between gap-3">
                        <div><p class="text-muted mb-2">Novos em 30 dias</p><div class="display-6 fw-bold">@clientes.Count(c => c.CriadoEm >= DateTime.UtcNow.AddDays(-30))</div></div>
                        <div class="rounded-3 bg-info bg-opacity-10 text-info p-3"><i class="bi bi-calendar-plus fs-4" aria-hidden="true"></i></div>
                    </div>
                    <span class="small text-muted">Desde @(DateTime.Today.AddDays(-30).ToString("dd/MM/yyyy"))</span>
                </div></div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-xl-8">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 px-4 pt-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                        <div><h2 class="h5 fw-bold mb-1">Cadastros recentes</h2><p class="small text-muted mb-0">Últimos clientes registrados no sistema.</p></div>
                        <a href="/admin/clientes" class="btn btn-outline-primary btn-sm">Ver todos</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light"><tr><th scope="col">Cliente / empresa</th><th scope="col">E-mail</th><th scope="col">Cadastro</th><th scope="col">Situação</th></tr></thead>
                            <tbody>
                                @foreach (var cliente in clientes.OrderByDescending(c => c.CriadoEm).Take(6))
                                {
                                    <tr @key="cliente.Id">
                                        <td><div class="fw-semibold">@cliente.Nome</div><small class="text-muted">@(cliente.Estabelecimento?.NomeFantasia ?? "Empresa não informada")</small></td>
                                        <td>@cliente.Email</td>
                                        <td>@FormatarData(cliente.CriadoEm)</td>
                                        <td><span class="badge @(cliente.Ativo ? "text-bg-success" : "text-bg-secondary")">@(cliente.Ativo ? "Ativo" : "Inativo")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (clientes.Count == 0)
                    {
                        <div class="text-center text-muted py-4">Ainda não há clientes cadastrados.</div>
                    }
                </div>
            </div>
            <div class="col-12 col-xl-4">
                <div class="card border-0 shadow-sm h-100"><div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-3"><i class="bi bi-grid me-2 text-primary" aria-hidden="true"></i> Administração</h2>
                    <p class="text-muted small">O painel administrativo é dedicado ao gerenciamento das contas de clientes.</p>
                    <div class="list-group list-group-flush">
                        <a href="/admin/clientes" class="list-group-item list-group-item-action px-0 py-3 d-flex gap-3 align-items-center">
                            <i class="bi bi-people text-primary fs-5" aria-hidden="true"></i><span class="flex-grow-1"><span class="d-block fw-semibold">Clientes</span><small class="text-muted">Cadastro, consulta e situação das contas</small></span><i class="bi bi-chevron-right text-muted" aria-hidden="true"></i>
                        </a>
                    </div>
                    <div class="alert alert-light border small mt-3 mb-0"><i class="bi bi-info-circle me-1" aria-hidden="true"></i> Produtos e categorias são gerenciados na interface de cada cliente, não neste painel.</div>
                </div></div>
            </div>
        </div>
        <div class="text-center text-muted small mt-4">Última consulta à API: @(ultimaAtualizacao?.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm"))</div>
    }
</div>

@code {
    private List<ClienteResumo> clientes = new();
    private bool carregando = true;
    private bool erro;
    private string mensagem = string.Empty;
    private DateTime? ultimaAtualizacao;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.EstaAutenticado || !string.Equals(Auth.Perfil, "ADMIN", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var baseUrl = Configuration["ApiBaseUrl"];
        if (!Uri.TryCreate(baseUrl, UriKind.Absolute, out var baseUri) ||
            (baseUri.Scheme != Uri.UriSchemeHttp && baseUri.Scheme != Uri.UriSchemeHttps))
        {
            DefinirErro("Configure ApiBaseUrl no projeto Merkdito.Web. Use a URL base da API, sem acrescentar /api.");
            carregando = false;
            return;
        }

        try
        {
            using var api = Auth.CriarClienteAutenticado();
            api.BaseAddress = new Uri(baseUri.AbsoluteUri.TrimEnd('/') + "/");
            using var resposta = await api.GetAsync("api/Clientes");

            if (resposta.StatusCode == HttpStatusCode.Unauthorized)
            {
                ExpirarSessao();
                return;
            }
            if (resposta.StatusCode == HttpStatusCode.Forbidden)
            {
                DefinirErro("Sua conta não tem permissão administrativa para consultar esses dados.");
                return;
            }
            if (!resposta.IsSuccessStatusCode)
            {
                DefinirErro("Não foi possível carregar as estatísticas dos clientes. Tente novamente.");
                return;
            }

            clientes = await resposta.Content.ReadFromJsonAsync<List<ClienteResumo>>() ?? new();
            ultimaAtualizacao = DateTime.UtcNow;
        }
        catch (HttpRequestException)
        {
            DefinirErro("Não foi possível conectar à API do Merkdito. Confira a URL configurada e se a API está disponível.");
        }
        catch (System.Text.Json.JsonException)
        {
            DefinirErro("A API retornou dados em um formato inesperado.");
        }
        finally
        {
            carregando = false;
        }
    }

    private void ExpirarSessao()
    {
        Auth.LimparSessao();
        Navigation.NavigateTo("/login");
    }

    private void DefinirErro(string texto)
    {
        erro = true;
        mensagem = texto;
    }

    private static string FormatarData(DateTime data) =>
        data == DateTime.MinValue ? "—" : data.ToLocalTime().ToString("dd/MM/yyyy");

    private sealed class ClienteResumo
    {
        public int Id { get; set; }
        public string Nome { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Telefone { get; set; }
        public bool Ativo { get; set; }
        public DateTime CriadoEm { get; set; }
        public EstabelecimentoResumo? Estabelecimento { get; set; }
    }

    private sealed class EstabelecimentoResumo
    {
        public int Id { get; set; }
        public string NomeFantasia { get; set; } = string.Empty;
        public string? Cnpj { get; set; }
        public bool Ativo { get; set; }
    }
}
