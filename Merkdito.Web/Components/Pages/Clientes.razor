    private static string FormatarData(DateTime data) =>
        data == DateTime.MinValue ? "—" : data.ToLocalTime().ToString("dd/MM/yyyy");

    private static string NormalizarCnpj(string? valor) =>
        new((valor ?? string.Empty).Where(char.IsLetterOrDigit).Select(char.ToUpperInvariant).ToArray());

    private static string FormatarCnpj(string? cnpj)
    {
        if (string.IsNullOrWhiteSpace(cnpj)) return "CNPJ não informado";
        var normalizado = NormalizarCnpj(cnpj);
        return normalizado.Length == 14
            ? $"{normalizado[..2]}.{normalizado[2..5]}.{normalizado[5..8]}/{normalizado[8..12]}-{normalizado[12..]}"
            : cnpj;
    }

    private static bool CnpjCorresponde(string? cnpj, string pesquisa)
    {
        var buscaNormalizada = NormalizarCnpj(pesquisa);
        if (buscaNormalizada.Length == 0 || string.IsNullOrWhiteSpace(cnpj)) return false;
        return NormalizarCnpj(cnpj).Contains(buscaNormalizada, StringComparison.OrdinalIgnoreCase);
    }

    private static bool CnpjValido(string? cnpj)

    {

        if (string.IsNullOrWhiteSpace(cnpj))

            return false;

        var numeros = NormalizarCnpj(cnpj);

        if (numeros.Length != 14)

            return false;

        if (!numeros[..12].All(char.IsAsciiLetterOrDigit) ||
            numeros[12] is < '0' or > '9' || numeros[13] is < '0' or > '9')
            return false;

        if (numeros.Distinct().Count() == 1)

            return false;

        static int CalcularDigito(string valor, int[] pesos)

        {

            var soma = 0;

            for (var i = 0; i < pesos.Length; i++)

                soma += (valor[i] - '0') * pesos[i];

            var resto = soma % 11;

            return resto < 2 ? 0 : 11 - resto;

        }

        int[] pesosPrimeiro =

        {

            5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2

        };

        int[] pesosSegundo =

        {

            6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2

        };

        var primeiroDigito =

            CalcularDigito(numeros[..12], pesosPrimeiro);

        if (primeiroDigito != numeros[12] - '0')

            return false;

        var segundoDigito =

            CalcularDigito(numeros[..13], pesosSegundo);

        return segundoDigito == numeros[13] - '0';

    }

