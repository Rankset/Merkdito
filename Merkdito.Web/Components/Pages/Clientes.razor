    private sealed class ClienteFormulario : IValidatableObject

    {

        public int Id { get; set; }

        [Required(ErrorMessage = "Informe o nome do cliente.")]

        [StringLength(150,

            ErrorMessage = "O nome deve ter até 150 caracteres.")]

        public string Nome { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o e-mail.")]

        [EmailAddress(ErrorMessage = "Informe um e-mail válido.")]

        [StringLength(254,

            ErrorMessage = "O e-mail deve ter até 254 caracteres.")]

        public string Email { get; set; } = string.Empty;

        [StringLength(30,

            ErrorMessage = "O telefone deve ter até 30 caracteres.")]

        public string? Telefone { get; set; }

        [Required(ErrorMessage = "Informe o nome fantasia.")]

        [StringLength(150,

            ErrorMessage = "O nome fantasia deve ter até 150 caracteres.")]

        public string NomeFantasia { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o CNPJ.")]

        [StringLength(18,

            MinimumLength = 14,

            ErrorMessage = "Informe o CNPJ completo.")]

        public string Cnpj { get; set; } = string.Empty;

        // A senha só é exigida no cadastro. SalvarCliente valida a política
        // condicionalmente, pois a senha não aparece no formulário de edição.
        public string SenhaInicial { get; set; } = string.Empty;

        // Validada condicionalmente apenas no cadastro, pois não se aplica à edição.
        public string ConfirmacaoSenhaInicial { get; set; } = string.Empty;

        public bool Ativo { get; set; } = true;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            // Senha e confirmação são obrigatórias somente no cadastro, não na edição.
            if (Id != 0)
                yield break;

            if (string.IsNullOrWhiteSpace(SenhaInicial))
            {
                yield return new ValidationResult(
                    "Informe a senha inicial.",
                    new[] { nameof(SenhaInicial) });
            }
            else if (SenhaInicial.Length > 128 ||
                     SenhaInicial.Length < 12 ||
                     !SenhaInicial.Any(char.IsUpper) ||
                     !SenhaInicial.Any(char.IsLower) ||
                     !SenhaInicial.Any(char.IsDigit) ||
                     !SenhaInicial.Any(c => !char.IsLetterOrDigit(c)))
            {
                yield return new ValidationResult(
                    "A senha deve ter entre 12 e 128 caracteres e conter maiúscula, minúscula, número e símbolo.",
                    new[] { nameof(SenhaInicial) });
            }

            if (SenhaInicial != ConfirmacaoSenhaInicial)
            {
                yield return new ValidationResult(
                    "A confirmação da senha inicial não corresponde à senha informada.",
                    new[] { nameof(ConfirmacaoSenhaInicial) });
            }
        }
    }

