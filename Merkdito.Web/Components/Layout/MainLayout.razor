@inherits LayoutComponentBase
@using Merkdito.Web.Services
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="merkdito-page">
    <aside class="merkdito-layout-sidebar" aria-label="Menu principal">
        <NavMenu />
    </aside>

    <div class="main-content">
        <header class="top-row px-4">
            <div class="d-flex flex-column">
                <span class="fw-semibold">Painel administrativo</span>
                <span class="small text-secondary">Gestão de clientes do Merkdito</span>
            </div>

            @if (Auth.EstaAutenticado && string.Equals(Auth.Perfil, "ADMIN", StringComparison.OrdinalIgnoreCase))
            {
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end d-none d-sm-block">
                        <span class="d-block small fw-semibold">@(Auth.Nome ?? "Administrador")</span>
                        <span class="d-block small text-secondary">@(Auth.Email ?? string.Empty)</span>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Sair">
                        <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>
                        Sair
                    </button>
                </div>
            }
        </header>

        <main class="content px-3 px-lg-4">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <button type="button" class="dismiss border-0 bg-transparent" aria-label="Fechar">×</button>
</div>

@code {
    private void Sair()
    {
        Auth.LimparSessao();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
